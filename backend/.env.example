# USB Qalqon web API sozlamalari
# Ushbu faylni .env deb nusxalab, qiymatlarni o'zgartiring.

APP_NAME=USB Qalqon API
SECRET_KEY=bu-yerga-juda-uzun-va-tasodifiy-kalit-yozing
ACCESS_TOKEN_EXPIRE_MINUTES=720
DATABASE_URL=sqlite:///./data/usbqalqon.db

# Frontend manzillari (vergul bilan ajratiladi)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Birinchi ishga tushirishda yaratiladigan administrator
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_FULL_NAME=Tizim administratori

# Agent paketlarida ko'rsatiladigan server manzili (bo'sh bo'lsa so'rov manzili olinadi)
SERVER_URL=http://localhost:8000
